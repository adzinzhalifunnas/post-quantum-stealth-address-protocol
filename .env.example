# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# TESTNET ONLY. Never put a key here that holds mainnet funds, and never point
# any RPC variable at a mainnet endpoint — the benchmark harness broadcasts
# transactions from these values.

# Ethereum Sepolia (chain id 11155111)
ETH_SEPOLIA_RPC_URL=

# Base Sepolia (chain id 84532)
BASE_SEPOLIA_RPC_URL=

# Deployer / funder EOA. Fans out testnet ETH to the fresh sample accounts the
# gas harness generates, so it needs a balance on both networks.
DEPLOYER_PRIVATE_KEY=

# Optional: block explorer keys for contract verification.
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
