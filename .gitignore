# Secrets — never commit. See .env.example for the required keys.
.env

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Foundry build artefacts
out/
cache/

# macOS
.DS_Store

# Deliberately NOT ignored (thesis reproducibility requires them in the repo):
#   uv.lock            exact Python dependency pins
#   dependencies/      forge-std, pinned as a git submodule — see README on why
#                      this needs `git clone --recurse-submodules`
#   bench/results/     measurement data — committed, never hand-edited
#   broadcast/         Foundry deployment audit trail, tying every measured row
#                      to the deployment transaction of specific bytecode
